/reference/
/data/extracted/
# Decoded map imagery (minimap, route overlays) — derived Blizzard/WC3 assets,
# kept local like the map file itself; not redistributed.
/data/reference/

# Local agent/editor tooling and scratch (preview config, workflow scripts).
.claude/

node_modules/
dist/
coverage/
*.log
.DS_Store
.env
.venv/
__pycache__/

# Stats service local SQLite database (and any other runtime data files).
# The .data/ dir itself is kept (its .gitignore is committed); contents are not.
packages/stats/.data/*
!packages/stats/.data/.gitignore
